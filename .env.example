# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Custom Authentication
JWT_SECRET=replace_with_secure_random_secret
# OpenRouter AI Configuration
OPENROUTER_API_KEY=replace_me
# AWS DynamoDB & S3 Configuration
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
S3_BUCKET_NAME=skillbridge-ai-evidence-2026

# Local Fallback Mode (allows running locally even without AWS credentials / OpenRouter credits)
USE_LOCAL_FALLBACK=true
